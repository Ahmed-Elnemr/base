<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
     # ----------------------------------------------------------------------
    # TASKS PROJECT (Laravel 2)
    # ----------------------------------------------------------------------

    # تحويل /tasks إلى مشروع Laravel الثاني
    RewriteRule ^tasks/?$ public/tasks/public/index.php [L]
    RewriteRule ^tasks/(.*)$ public/tasks/public/$1 [L]

    # ----------------------------------------------------------------------
    # NEXT.JS FRONTEND REWRITES (Inside public/front)
    # ----------------------------------------------------------------------

    # 1. Serve Next.js clean HTML URLs (e.g. rewrite /about to /front/about.html if it exists)
    RewriteCond %{REQUEST_URI} !^/admin [NC]
    RewriteCond %{REQUEST_URI} !^/api [NC]
    RewriteCond %{REQUEST_URI} !^/storage [NC]
    RewriteCond %{REQUEST_URI} !^/livewire [NC]
    RewriteCond %{REQUEST_URI} !^/front [NC]
    RewriteCond %{REQUEST_URI} !^/run- [NC]
    RewriteCond %{REQUEST_URI} !^/support [NC]
    RewriteCond %{REQUEST_URI} !^/tasks [NC]
    RewriteCond %{DOCUMENT_ROOT}/front/$1.html -f
    RewriteRule ^(.*)$ front/$1.html [L]

    # 2. Rewrite root '/' to 'front/' directory
    RewriteRule ^$ front/ [L]

    # 3. General fallback: Rewrite non-existent assets and subpages to the 'front' folder
    # (e.g. /_next/... to /front/_next/..., /about to /front/about)
    RewriteCond %{REQUEST_URI} !^/admin [NC]
    RewriteCond %{REQUEST_URI} !^/api [NC]
    RewriteCond %{REQUEST_URI} !^/storage [NC]
    RewriteCond %{REQUEST_URI} !^/livewire [NC]
    RewriteCond %{REQUEST_URI} !^/front [NC]
    RewriteCond %{REQUEST_URI} !^/run- [NC]
    RewriteCond %{REQUEST_URI} !^/support [NC]
    RewriteCond %{REQUEST_URI} !^/tasks [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ front/$1 [L]

    # ----------------------------------------------------------------------

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
