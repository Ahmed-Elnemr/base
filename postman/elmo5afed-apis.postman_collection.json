    {
      "name": "Submit support message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"John Doe\",\n  \"phone\": \"0555555555\",\n  \"email\": \"john@example.com\",\n  \"message_type\": \"inquiry\",\n  \"message\": \"I would like to book a mobile detailing session.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/support/messages",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "support",
            "messages"
          ]
        }
      },
      "description": "Allowed message_type values: inquiry, complaint, suggestion, other."
    },
    {
      "name": "Authentication",
      "description": "User registration, login and token lifecycle endpoints.",
      "item": [
