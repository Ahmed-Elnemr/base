                            },
                            {
                                "key": "Accept-Language",
                                "value": "ar"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "name",
                                    "value": "Updated Name",
                                    "type": "text"
                                },
                                {
                                    "key": "mobile",
                                    "value": "0123456789",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/profile/update",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "auth",
                                "profile",
                                "update"
