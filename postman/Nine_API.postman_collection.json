                                "api",
                                "v1",
                                "notifications",
                                "unread-count"
                            ]
                        },
                        "description": "Get count of unread notifications"
                    }
                },
                {
                    "name": "Delete Notification",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/notifications/:uuid",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "notifications",
                                ":uuid"
                            ],
                            "variable": [
                                {
                                    "key": "uuid",
                                    "value": "notification-uuid-here"
                                }
                            ]
                        },
                        "description": "Delete a specific notification by UUID"
                    }
                },
                {
                    "name": "Delete All Notifications",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/notifications",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "notifications"
                            ]
                        },
                        "description": "Delete all notifications for the authenticated user"
                    }
                }
            ]
        },
