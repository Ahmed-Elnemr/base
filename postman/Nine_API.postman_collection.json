                {
                    "name": "Get Unread Notifications",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "ar"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/notifications/unread",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "notifications",
                                "unread"
                            ]
                        },
                        "description": "Get only unread notifications (does NOT mark as read)"
                    }
                },
                {
                    "name": "Get Unread Count",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "ar"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/notifications/unread-count",
                            "host": [
                                "{{base_url}}"
                            ],
