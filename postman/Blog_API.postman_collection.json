{
    "info": {
        "name": "Blog API",
        "_postman_id": "blog-api-collection",
        "description": "Blog posts endpoints — list all published posts (paginated) and retrieve a single post by slug.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "List Blog Posts",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "ar"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/blog-posts?per_page=15",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "blog-posts"
                    ],
                    "query": [
                        {
                            "key": "per_page",
                            "value": "15",
                            "description": "Number of posts per page (default: 15)"
                        }
                    ]
                },
                "description": "Returns a paginated list of active blog posts. Each item contains id, title, description, slug, thumbnail, preview_image, keywords, and created_at. Content body is excluded from the listing — use the show endpoint to get full content."
            },
            "response": [
                {
                    "name": "200 OK — List",
                    "status": "OK",
                    "code": 200,
                    "originalRequest": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/blog-posts?per_page=15",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "blog-posts"
                            ],
                            "query": [
                                {
                                    "key": "per_page",
                                    "value": "15"
                                }
                            ]
                        }
                    },
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n  \"success\": true,\n  \"message\": \"Blog posts loaded successfully\",\n  \"data\": {\n    \"data\": [\n      {\n        \"id\": 1,\n        \"title\": \"أول مقال في المدونة\",\n        \"description\": \"وصف مختصر للمقالة الأولى\",\n        \"slug\": \"first-blog-post\",\n        \"thumbnail\": \"http://127.0.0.1:8000/storage/thumbnail/1/thumbnail.jpg\",\n        \"preview_image\": \"http://127.0.0.1:8000/storage/preview/1/preview.jpg\",\n        \"keywords\": [\"كلمة مفتاحية\", \"مدونة\"],\n        \"created_at\": \"2026-02-28T03:00:00.000000Z\"\n      }\n    ],\n    \"current_page\": 1,\n    \"last_page\": 1,\n    \"per_page\": 15,\n    \"total\": 1\n  }\n}"
                }
            ]
        },
        {
            "name": "Show Blog Post (by slug)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Accept-Language",
                        "value": "ar"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/blog-posts/:slug",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "blog-posts",
                        ":slug"
                    ],
                    "variable": [
                        {
                            "key": "slug",
                            "value": "first-blog-post",
                            "description": "The unique URL slug of the blog post"
                        }
                    ]
                },
                "description": "Returns the full details of a single active blog post identified by its slug. Includes the full content body in addition to all listing fields."
            },
            "response": [
                {
                    "name": "200 OK — Show",
                    "status": "OK",
                    "code": 200,
                    "originalRequest": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/blog-posts/first-blog-post",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "blog-posts",
                                "first-blog-post"
                            ]
                        }
                    },
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n  \"success\": true,\n  \"message\": \"Blog post loaded successfully\",\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"أول مقال في المدونة\",\n    \"description\": \"وصف مختصر للمقالة الأولى\",\n    \"slug\": \"first-blog-post\",\n    \"thumbnail\": \"http://127.0.0.1:8000/storage/thumbnail/1/thumbnail.jpg\",\n    \"preview_image\": \"http://127.0.0.1:8000/storage/preview/1/preview.jpg\",\n    \"keywords\": [\"كلمة مفتاحية\", \"مدونة\"],\n    \"content\": \"<p>محتوى المقالة الكامل هنا...</p>\",\n    \"created_at\": \"2026-02-28T03:00:00.000000Z\",\n    \"updated_at\": \"2026-02-28T03:00:00.000000Z\"\n  }\n}"
                },
                {
                    "name": "404 Not Found",
                    "status": "Not Found",
                    "code": 404,
                    "originalRequest": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/blog-posts/non-existent-slug",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "blog-posts",
                                "non-existent-slug"
                            ]
                        }
                    },
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n  \"success\": false,\n  \"message\": \"Blog post not found\",\n  \"data\": null\n}"
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        }
    ]
}